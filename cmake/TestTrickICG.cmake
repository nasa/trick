cmake_minimum_required(VERSION 3.26)
include("${CMAKE_CURRENT_LIST_DIR}/TrickICGInvoke.cmake")
if(NOT IS_ABSOLUTE "${ICG_TEST_ROOT}")
    message(FATAL_ERROR "ICG_TEST_ROOT must be an absolute build-tree path")
endif()
cmake_path(NORMAL_PATH ICG_TEST_ROOT OUTPUT_VARIABLE root)
set(expected ${icg_outputs})
list(TRANSFORM expected PREPEND "${root}/")
list(SORT expected)

# ANSI '[' and diagnostic semicolons must not be interpreted as CMake lists.
string(ASCII 27 escape)
set(progress "${escape}[1;34mWriting    ${escape}[39mfile\n")
set(warning "warning: [important]; preserve punctuation\n")
trick_icg_filter_progress("${progress}${warning}Writing    next\n${warning}" filtered)
if(NOT filtered STREQUAL "${warning}${warning}")
    message(FATAL_ERROR "Progress filtering lost or changed diagnostics")
endif()
trick_icg_filter_progress("${warning}${progress}Writing    last" filtered)
if(NOT filtered STREQUAL "${warning}")
    message(FATAL_ERROR "Progress filtering changed a retained line ending")
endif()

function(snapshot_source source result)
    # Legacy ICG writes ignored files here. Record names as well as contents to
    # detect both newly created files and changes to existing ignored outputs.
    file(GLOB_RECURSE er7_files LIST_DIRECTORIES FALSE "${source}/trick_source/er7_utils/*")
    list(FILTER er7_files INCLUDE REGEX "/io_src/")
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE
        "${source}/trick_source/sim_services/include/io_src/*"
        "${source}/share/trick/xml/*")
    list(APPEND files ${er7_files})
    list(SORT files)
    set(snapshot)
    foreach(path IN LISTS files)
        file(SHA256 "${path}" hash)
        list(APPEND snapshot "${path}:${hash}")
    endforeach()
    set(${result} "${snapshot}" PARENT_SCOPE)
endfunction()

snapshot_source("${icg_source_dir}" before)
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(source_link "${root}-source-link")
file(CREATE_LINK "${icg_source_dir}" "${source_link}" SYMBOLIC)
foreach(scenario IN ITEMS initial repeated_existing_directory symlink_home)
    set(home "${icg_source_dir}")
    if(scenario STREQUAL "initial")
        unset(ENV{TRICK_ICG_NOCOMMENT})
    else()
        # These ambient settings must not change a configured CMake build.
        set(ENV{TRICK_ICG_NOCOMMENT} 1)
        set(ENV{TRICK_CXX} "/not-the-configured-compiler")
    endif()
    if(scenario STREQUAL "symlink_home")
        set(home "${source_link}/")
    endif()
    # Deliberately do not clean between direct invocations.
    trick_icg_invoke("${root}" "${home}" result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "ICG scenario ${scenario} failed: ${result}")
    endif()
    file(GLOB_RECURSE actual "${root}/*")
    list(SORT actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "ICG did not generate exactly the declared outputs")
    endif()
    set(hashes)
    foreach(path IN LISTS actual)
        file(SHA256 "${path}" hash)
        list(APPEND hashes "${hash}")
    endforeach()
    if(scenario STREQUAL "initial")
        set(first_hashes "${hashes}")
    elseif(NOT hashes STREQUAL first_hashes)
        message(FATAL_ERROR "Repeated ICG output differs (including XML)")
    endif()
endforeach()

# Exercise publication independently of the direct repeated-invocation test.
set(published "${root}-published")
file(REMOVE_RECURSE "${published}" "${published}.stage")
file(REMOVE "${published}.complete")
function(publish executable result_var)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DICG=${executable}"
            "-DICG_SETTINGS=${ICG_SETTINGS}" "-DICG_OUTPUT_ROOT=${published}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunTrickICG.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    set(${result_var} "${result}" PARENT_SCOPE)
    set(publish_output "${output}" PARENT_SCOPE)
endfunction()
function(snapshot_outputs result_var)
    file(GLOB_RECURSE paths LIST_DIRECTORIES FALSE "${published}/*")
    list(APPEND paths "${published}.d")
    list(SORT paths)
    set(snapshot)
    foreach(path IN LISTS paths)
        file(SHA256 "${path}" hash)
        file(TIMESTAMP "${path}" timestamp "%s.%f" UTC)
        list(APPEND snapshot "${path}:${timestamp}:${hash}")
    endforeach()
    set(${result_var} "${snapshot}" PARENT_SCOPE)
endfunction()
publish("${ICG}" result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Initial publication failed:\n${publish_output}")
endif()
snapshot_outputs(published_before)
# Regenerating unchanged content must preserve timestamps and remove stale files.
file(WRITE "${published}/stale-output.cpp" "old inventory")
publish("${ICG}" result)
snapshot_outputs(published_after)
if(NOT result EQUAL 0 OR NOT published_before STREQUAL published_after
        OR EXISTS "${published}/stale-output.cpp")
    message(FATAL_ERROR "Repeated publication changed outputs or left stale files")
endif()
file(TIMESTAMP "${published}.complete" completion_before "%s.%f" UTC)
publish("${CMAKE_COMMAND}" result)
snapshot_outputs(published_after)
file(TIMESTAMP "${published}.complete" completion_after "%s.%f" UTC)
if(result EQUAL 0 OR NOT completion_before STREQUAL completion_after
        OR NOT published_before STREQUAL published_after)
    message(FATAL_ERROR "Failed generation modified published products")
endif()
# Inventory errors must identify only the differences, using relative paths.
file(READ "${ICG_SETTINGS}" settings)
set(original_settings "${ICG_SETTINGS}")
set(ICG_SETTINGS "${root}-mismatched-settings.cmake")
file(WRITE "${ICG_SETTINGS}" "${settings}\n"
    "list(REMOVE_ITEM icg_outputs sim_services/io_src/io_Clock.cpp)\n"
    "list(APPEND icg_outputs sim_services/io_src/io_Missing.cpp)\n")
publish("${ICG}" result)
set(ICG_SETTINGS "${original_settings}")
string(FIND "${publish_output}" "ICG output inventory mismatch." error_start)
if(result EQUAL 0 OR error_start LESS 0)
    message(FATAL_ERROR "Expected an inventory error:\n${publish_output}")
endif()
string(SUBSTRING "${publish_output}" ${error_start} -1 inventory_error)
if(NOT inventory_error MATCHES "Missing:[ \t\r\n]+sim_services/io_src/io_Missing[.]cpp"
        OR NOT inventory_error MATCHES "Unexpected:[ \t\r\n]+sim_services/io_src/io_Clock[.]cpp"
        OR inventory_error MATCHES "sim_services/io_src/io_Executive.cpp")
    message(FATAL_ERROR "Inventory error did not show concise relative differences:\n${publish_output}")
endif()
snapshot_outputs(published_after)
file(TIMESTAMP "${published}.complete" completion_after "%s.%f" UTC)
if(NOT published_before STREQUAL published_after OR NOT completion_before STREQUAL completion_after)
    message(FATAL_ERROR "Inventory failure modified published products")
endif()
foreach(path IN LISTS expected)
    string(REPLACE "${root}/" "${published}/" published_path "${path}")
    file(SHA256 "${path}" direct_hash)
    file(SHA256 "${published_path}" published_hash)
    if(NOT direct_hash STREQUAL published_hash)
        message(FATAL_ERROR "Staging changed output content: ${path}")
    endif()
endforeach()
snapshot_source("${icg_source_dir}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "ICG modified the source checkout")
endif()
execute_process(
    COMMAND "${ICG}" -sim_services -m --output-root "${root}" -o "${root}"
        "${icg_source_dir}/include/trick/files_to_ICG.hh"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "ICG accepted incompatible output modes")
endif()
file(WRITE "${root}/not-a-directory" "blocked")
trick_icg_invoke("${root}/not-a-directory" "${icg_source_dir}" result)
if(result EQUAL 0)
    message(FATAL_ERROR "ICG reported success for an unwritable output root")
endif()
