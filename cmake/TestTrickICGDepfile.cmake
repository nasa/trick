build_case(changed_system_noop unchanged)
snapshot(before)
separate_edit()
file(WRITE "${home}/include/trick/Unrelated.hh" "#error must never be parsed\n")
build_case(unrelated unchanged)
assert_unchanged("${before}")

snapshot(before)
separate_edit()
file(WRITE "${main}" "${valid_main}\n#error intentional invalid user header\n")
build_case(invalid_main failed)
assert_unchanged("${before}")
separate_edit()
file(WRITE "${main}" "${valid_main}")
