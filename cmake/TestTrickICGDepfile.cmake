cmake_minimum_required(VERSION 3.26)
# Standalone integration test. Each generator must receive a unique test root.
foreach(required IN ITEMS TEST_GENERATOR TEST_MAKE_PROGRAM)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing -D${required}")
    endif()
endforeach()
set(scripts "${CMAKE_CURRENT_LIST_DIR}")
set(fixture "${scripts}/tests/icg-depfile")
set(system_name "system #$.hh")
if(TEST_GENERATOR STREQUAL "Ninja" AND CMAKE_VERSION VERSION_LESS 4.4)
    # Keep until the minimum is 4.4: older Ninja conversion loses #/$ escaping.
    set(system_name "system header.hh")
endif()
include("${fixture}/CreateFixture.cmake")

function(configure_fixture name)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${build}" ${ARGN}
        -G "${TEST_GENERATOR}" "-DCMAKE_MAKE_PROGRAM=${TEST_MAKE_PROGRAM}"
        "-DICG=${ICG}" "-DICG_SETTINGS=${work}/settings.cmake" "-DICG_SCRIPTS=${scripts}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    file(WRITE "${work}/${name}.log" "${output}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture configure failed; see ${work}/${name}.log:\n${output}")
    endif()
endfunction()
configure_fixture(configure)

function(build_case name expectation)
    # Successful publication updates the real stamp; no test-only command wrapper.
    file(TIMESTAMP "${root}.complete" before "%s.%f" UTC)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
    file(WRITE "${work}/${name}.log" "${output}")
    if(expectation STREQUAL "failed")
        if(result EQUAL 0 OR NOT output MATCHES "intentional invalid user header")
            message(FATAL_ERROR "${name}: expected ICG's parse error:\n${output}")
        endif()
        return()
    endif()
    if(NOT result EQUAL 0 OR NOT EXISTS "${root}.complete")
        message(FATAL_ERROR "${name}: unexpected build result ${result}; see ${work}/${name}.log:\n${output}")
    endif()
    file(TIMESTAMP "${root}.complete" after "%s.%f" UTC)
    if(expectation STREQUAL "changed" AND before STREQUAL after)
        message(FATAL_ERROR "${name}: generation did not update the stamp")
    elseif(expectation STREQUAL "unchanged" AND NOT before STREQUAL after)
        message(FATAL_ERROR "${name}: generation ran unnecessarily")
    endif()
endfunction()

function(snapshot result)
    file(GLOB_RECURSE paths LIST_DIRECTORIES FALSE "${root}/*")
    list(APPEND paths "${root}.d" "${root}.complete")
    list(SORT paths)
    set(state "")
    foreach(path IN LISTS paths)
        file(SHA256 "${path}" hash)
        file(TIMESTAMP "${path}" time "%s.%f" UTC)
        string(APPEND state "${path}:${hash}:${time}\n")
    endforeach()
    set(${result} "${state}" PARENT_SCOPE)
endfunction()

function(assert_unchanged before)
    snapshot(after)
    if(NOT "${before}" STREQUAL "${after}")
        message(FATAL_ERROR "Published output/depfile/stamp contents or timestamps changed unexpectedly")
    endif()
endfunction()

function(separate_edit)
    # Make compares timestamps at whole-second granularity.
    if(TEST_GENERATOR STREQUAL "Unix Makefiles")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1 COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

function(local_hash result)
    file(SHA256 "${root}/sim_services/io_src/io_Local.cpp" hash)
    set(${result} "${hash}" PARENT_SCOPE)
endfunction()

build_case(initial changed)
snapshot(initial)
build_case(unchanged unchanged)
assert_unchanged("${initial}")

separate_edit()
file(TOUCH "${nested}")
build_case(touched_nested changed)
build_case(touched_nested_noop unchanged)
