    "#define LOCAL_SIZE 5\n#include <${system_name}>\nclass Local { public: int values[LOCAL_SIZE + SYSTEM_SIZE]; };\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E rm -f "${nested}"
    COMMAND_ERROR_IS_FATAL ANY)
build_case(removed_include changed)
file(READ "${root}.d" dependencies)
if(dependencies MATCHES "Nested[.]hh")
    message(FATAL_ERROR "Removed header remains in published depfile")
endif()
if(TEST_GENERATOR STREQUAL "Unix Makefiles" AND CMAKE_VERSION VERSION_LESS 4.0)
    # Keep until the minimum is 4.0: old Makefile generators retain removed inputs.
    # Exercise the documented public recovery, not private CMake cache files.
    configure_fixture(removed_include_fresh --fresh)
    build_case(removed_include_recovered changed)
    build_case(removed_include_noop unchanged)
else()
    build_case(removed_include_noop unchanged)
endif()

message(STATUS "Real ICG depfile scenarios passed (${TEST_GENERATOR}); logs: ${work}")
