{
  "name": "vscode-trick",
  "displayName": "Trick Simulation Toolkit",
  "description": "S_define/.sm language support, per-sim IntelliSense, build/run tasks, and live sim views for the Trick Simulation Toolkit",
  "version": "1.0.0",
  "publisher": "trick-sim",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/nasa/trick"
  },
  "bugs": {
    "url": "https://github.com/nasa/trick/issues"
  },
  "homepage": "https://github.com/nasa/trick",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:trick-sdefine",
    "workspaceContains:**/S_overrides.mk",
    "workspaceContains:**/S_define"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trick",
          "title": "Trick",
          "icon": "./icons/trick-activity.svg"
        }
      ]
    },
    "views": {
      "trick": [
        {
          "id": "trickSims",
          "name": "Sims"
        },
        {
          "id": "trickSimsConnected",
          "name": "Connected"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "trickSims",
        "contents": "No sims found.\nRunning sims broadcast over UDP multicast every couple of seconds and should appear here automatically. This is off by default on macOS, and may be blocked by a firewall or VPN elsewhere.\n[Connect to host:port…](command:trick.sims.connectManual)\n\nThe variable server port a running sim is using is printed to its console, or can be read with `trick.var_server_get_port()` in its input file."
      },
      {
        "view": "trickSimsConnected",
        "contents": "Not connected to a sim.\nClick the plug button on a sim in the Sims view above, or [Connect to host:port…](command:trick.sims.connectManual)."
      }
    ],
    "languages": [
      {
        "id": "trick-sdefine",
        "aliases": [
          "Trick",
          "trick-sdefine"
        ],
        "filenames": [
          "S_define"
        ],
        "extensions": [
          ".sm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/trick-flag.png",
          "dark": "./icons/trick-flag.png"
        }
      },
      {
        "id": "python",
        "extensions": [
          ".dr"
        ]
      }
    ],
    "grammars": [
      {
        "language": "trick-sdefine",
        "scopeName": "source.trick-sdefine",
        "path": "./syntaxes/trick-sdefine.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "trick-sdefine",
        "path": "./snippets/trick-sdefine.json"
      },
      {
        "language": "python",
        "path": "./snippets/trick-python.json"
      }
    ],
    "commands": [
      {
        "command": "trick.refreshSimConfiguration",
        "title": "Trick: Refresh Sim Configuration"
      },
      {
        "command": "trick.showResolvedIncludePaths",
        "title": "Trick: Show Resolved Include Paths"
      },
      {
        "command": "trick.regeneratePythonStubs",
        "title": "Trick: Regenerate Python Stubs"
      },
      {
        "command": "trick.buildCurrentSim",
        "title": "Trick: Build Current Sim"
      },
      {
        "command": "trick.runCurrentSim",
        "title": "Trick: Run Current Sim",
        "icon": "$(play)"
      },
      {
        "command": "trick.sims.connect",
        "title": "Connect",
        "icon": "$(plug)"
      },
      {
        "command": "trick.sims.disconnect",
        "title": "Disconnect"
      },
      {
        "command": "trick.sims.connectManual",
        "title": "Trick: Connect to Sim (host:port)…",
        "icon": "$(add)"
      },
      {
        "command": "trick.sims.run",
        "title": "Run",
        "icon": "$(debug-start)"
      },
      {
        "command": "trick.sims.freeze",
        "title": "Freeze",
        "icon": "$(debug-pause)"
      },
      {
        "command": "trick.sims.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "trick.sims.addWatch",
        "title": "Add Watch…",
        "icon": "$(eye)"
      },
      {
        "command": "trick.sims.removeWatch",
        "title": "Remove Watch",
        "icon": "$(close)"
      },
      {
        "command": "trick.sims.watchFromEditor",
        "title": "Trick: Watch in Trick Sims View"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "trick.sims.connectManual",
          "when": "view == trickSims",
          "group": "navigation"
        },
        {
          "command": "trick.sims.connectManual",
          "when": "view == trickSimsConnected",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "trick.sims.connect",
          "when": "view == trickSims && viewItem == sim.disconnected",
          "group": "inline"
        },
        {
          "command": "trick.sims.run",
          "when": "view == trickSimsConnected && viewItem == sim.frozen",
          "group": "inline@1"
        },
        {
          "command": "trick.sims.freeze",
          "when": "view == trickSimsConnected && viewItem == sim.running",
          "group": "inline@1"
        },
        {
          "command": "trick.sims.stop",
          "when": "view == trickSimsConnected && viewItem =~ /^sim\\.(running|frozen)$/",
          "group": "inline@2"
        },
        {
          "command": "trick.sims.addWatch",
          "when": "view == trickSimsConnected && viewItem =~ /^sim\\.(running|frozen)$/",
          "group": "inline@3"
        },
        {
          "command": "trick.sims.disconnect",
          "when": "view == trickSimsConnected && viewItem =~ /^sim\\.(running|frozen|ended)$/",
          "group": "inline@9"
        },
        {
          "command": "trick.sims.removeWatch",
          "when": "view == trickSimsConnected && viewItem == watch",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "trick.sims.watchFromEditor",
          "when": "editorLangId == python",
          "group": "9_trick"
        },
        {
          "command": "trick.runCurrentSim",
          "when": "trick.inSimRoot",
          "group": "9_trick"
        }
      ],
      "editor/title": [
        {
          "command": "trick.runCurrentSim",
          "when": "trick.inSimRoot && resourceLangId == python && resourcePath =~ /\\/RUN_[^/]+\\/[^/]+\\.py$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "trick.buildCurrentSim",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "trick.inSimRoot"
      },
      {
        "command": "trick.runCurrentSim",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "trick.inSimRoot"
      }
    ],
    "taskDefinitions": [
      {
        "type": "trick",
        "required": [
          "simRoot"
        ],
        "properties": {
          "simRoot": {
            "type": "string",
            "description": "Path to the sim directory (containing S_define) to build."
          },
          "inputFile": {
            "type": "string",
            "description": "RUN_*/*.py input file (relative to simRoot) to run. Only present on a run task."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "trick",
        "owner": "trick",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Trick",
      "properties": {
        "trick.home": {
          "type": "string",
          "default": "",
          "description": "Path to TRICK_HOME. Leave empty to use the TRICK_HOME environment variable or auto-detect from PATH."
        },
        "trick.useMakeForFlags": {
          "type": "boolean",
          "default": true,
          "description": "Resolve each sim's TRICK_CFLAGS/TRICK_CXXFLAGS/TRICK_SFLAGS by invoking make against Trick's own makefiles (exact). Disable to use a best-effort regex parse of S_overrides.mk only."
        },
        "trick.cppStandard": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "c++11",
            "c++14",
            "c++17",
            "c++20"
          ],
          "description": "Override the C++ standard reported to the C/C++ extension. Leave empty to infer from -std= flags (default c++14)."
        },
        "trick.python.generateStubs": {
          "type": "boolean",
          "default": true,
          "description": "Generate a trick.* Python stub and __builtins__.pyi per workspace folder (for Pylance completions/hover and to stop flagging trick/sim objects as undefined in input.py and .dr files). Writes into .vscode/trick-python/ and __builtins__.pyi, excluded from git via .git/info/exclude."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run compile",
    "test": "mocha",
    "prepackage": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-cpptools": "^6.1.0"
  }
}
