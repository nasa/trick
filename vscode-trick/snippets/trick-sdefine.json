{
  "Trick header comment": {
    "prefix": "header",
    "body": [
      "/************************TRICK HEADER*************************",
      "PURPOSE:",
      "    ( ${1:Describe what this simulation does.} )",
      "LIBRARY DEPENDENCIES:",
      "    (",
      "    (${2:relative/path/to/model.cpp})",
      "    )",
      "*************************************************************/"
    ],
    "description": "Trick header comment block parsed by CP for library dependencies"
  },

  "Model header include (##include)": {
    "prefix": "##include",
    "body": "##include \"${1:relative/path/to/model_header.h}\"",
    "description": "Double-pound include: model header copied verbatim into S_source.hh"
  },

  "S_define include (#include)": {
    "prefix": "#include",
    "body": "#include \"${1:sim_objects/file.sm}\"",
    "description": "Single-pound include: parsed by CP as part of S_define"
  },

  "User header block": {
    "prefix": "%header",
    "body": [
      "%header{",
      "\t$0",
      "%}"
    ],
    "description": "Raw code copied into S_source.hh without CP processing"
  },

  "User code block": {
    "prefix": "%{",
    "body": [
      "%{",
      "\t$0",
      "%}"
    ],
    "description": "Raw code copied into S_source.cpp after all includes"
  },

  "SimObject class skeleton": {
    "prefix": "simobject",
    "body": [
      "class ${1:MySimObject} : public Trick::SimObject {",
      "    public:",
      "        ${2:ModelClass} ${3:model};",
      "",
      "        ${1:MySimObject}() {",
      "            (\"default_data\") ${3:model}.default_data();",
      "            (\"initialization\") ${3:model}.state_init();",
      "            (${4:0.01}, \"scheduled\") ${3:model}.update();",
      "        }",
      "};",
      "",
      "${1:MySimObject} $5;"
    ],
    "description": "Sim object class with constructor and starter jobs"
  },

  "Job: default_data": {
    "prefix": "job-default_data",
    "body": "(\"default_data\") ${1:module}(${2:args});",
    "description": "Runs once at sim time zero, before input file is read"
  },
  "Job: initialization": {
    "prefix": "job-initialization",
    "body": "(\"initialization\") ${1:module}(${2:args});",
    "description": "Runs once at sim time zero, after input file is read"
  },
  "Job: scheduled": {
    "prefix": "job-scheduled",
    "body": "(${1:0.1}, \"scheduled\") ${2:module}(${3:args});",
    "description": "Cyclic job run at the given period"
  },
  "Job: derivative": {
    "prefix": "job-derivative",
    "body": "(\"derivative\") ${1:module}(${2:args});",
    "description": "Equations-of-motion derivative function"
  },
  "Job: integration": {
    "prefix": "job-integration",
    "body": "(\"integration\") trick_ret = ${1:module}(${2:args});",
    "description": "Equations-of-motion state integration function (must return int)"
  },
  "Job: dynamic_event": {
    "prefix": "job-dynamic_event",
    "body": "(\"dynamic_event\") ${1:module}(${2:args});",
    "description": "Root-finding event job run after the integration loop"
  },
  "Job: shutdown": {
    "prefix": "job-shutdown",
    "body": "(\"shutdown\") ${1:module}(${2:args});",
    "description": "Runs once at simulation termination"
  },

  "IntegLoop": {
    "prefix": "IntegLoop",
    "body": "IntegLoop ${1:dyn_integloop} (${2:0.01}) ${3:dyn};",
    "description": "Declare an integration loop over one or more sim objects"
  },

  "integrate": {
    "prefix": "integrate",
    "body": "integrate ${1:my_integ_loop} (${2:0.01}) ${3:ball};",
    "description": "Legacy integration loop declaration"
  },

  "collect": {
    "prefix": "collect",
    "body": "collect ${1:ball.state.output.force} = {${2:ball.force.x}, ${3:ball.force.y}};",
    "description": "Parameter collection into a vector/array"
  },

  "job_class_order": {
    "prefix": "job_class_order",
    "body": [
      "job_class_order {",
      "   ${1:my_job_class_1},",
      "   ${2:my_job_class_2}",
      "};"
    ],
    "description": "Override the default scheduled job class execution order"
  },

  "create_connections": {
    "prefix": "create_connections",
    "body": [
      "void create_connections() {",
      "\t$0",
      "}"
    ],
    "description": "Glue code run after all sim objects are instantiated"
  }
}
